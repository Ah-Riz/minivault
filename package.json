{
  "name": "minivault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint:fix": "prettier --check \"**/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "prettier --write \"**/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "anchor test",
    "sync-idl": "bash scripts/sync-idl.sh",
    "build": "anchor build && npm run sync-idl",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "setup:devnet": "ANCHOR_PROVIDER_URL=https://api.devnet.solana.com npx tsx scripts/devnet-setup.ts",
    "ship:devnet": "npm run build && npm run deploy:devnet && npm run setup:devnet"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.6",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "prettier": "^3.3.3",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
